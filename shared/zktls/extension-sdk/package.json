{
  "name": "@umia/zktls-extension-sdk",
  "private": true,
  "version": "0.5.2",
  "exports": {
    ".": {
      "import": "./build/ReclaimExtensionSDK.bundle.js",
      "types": "./index.d.ts"
    },
    "./background": "./build/background/background.bundle.js",
    "./content": "./build/content/content.bundle.js",
    "./offscreen": "./build/offscreen/offscreen.bundle.js",
    "./interceptor/network": "./build/interceptor/network-interceptor.bundle.js",
    "./provider-access": "./src/background/providerAccess.js",
    "./ui/*": "./src/ui/*"
  },
  "types": "./index.d.ts",
  "scripts": {
    "build": "NODE_ENV=production node webpack-build-utils/build.js",
    "build:mark-css": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON webpack-build-utils/build-mark-css.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.js\" && bun test ./tests",
    "test:build": "bun test ./build-checks"
  },
  "author": "Umia",
  "license": "MIT",
  "dependencies": {
    "@extism/extism": "^1.0.3",
    "@reclaimprotocol/attestor-core": "5.1.5",
    "@reclaimprotocol/tls": "git+https://git@github.com/reclaimprotocol/tls.git#8e0669a220341432673a20bb51f9339555701ef4",
    "@reclaimprotocol/zk-symmetric-crypto": "5.1.7",
    "@umia/zktls-config": "workspace:*",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "3.12.1",
    "domhandler": "^5.0.3",
    "esprima-next": "^5.8.4",
    "ethers": "^6.13.1",
    "jsonpath-plus": "^10.4.0",
    "lottie-web": "5.13.0",
    "os-browserify": "^0.3.0",
    "p-queue": "^8.0.1",
    "parse5": "^8.0.0",
    "parse5-htmlparser2-tree-adapter": "8.0.0",
    "path-browserify": "1.0.1",
    "process": "^0.11.10",
    "snarkjs": "^0.7.5",
    "stream-browserify": "^3.0.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.10",
    "@types/chrome": "^0.0.202",
    "@types/node": "^20.4.10",
    "assert": "^2.1.0",
    "babel-loader": "^9.1.2",
    "constants-browserify": "^1.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "ejs": "3.1.10",
    "fs-extra": "^11.1.0",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.0",
    "https-browserify": "^1.0.0",
    "node-polyfill-webpack-plugin": "4.1.0",
    "postcss-loader": "^7.3.3",
    "react-refresh": "^0.14.0",
    "sass": "^1.57.1",
    "sass-loader": "^13.2.0",
    "source-map-loader": "^3.0.1",
    "stream-http": "^3.2.0",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.3.6",
    "text-encoding": "^0.7.0",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.4",
    "url": "^0.11.3",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.75.0",
    "webpack-dev-server": "5.2.2",
    "zip-webpack-plugin": "^4.0.1"
  },
  "browser": {
    "fs": false,
    "child_process": false,
    "koffi": false,
    "re2": false,
    "worker_threads": false,
    "snarkjs": false,
    "node:url": "url/"
  }
